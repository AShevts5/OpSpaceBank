# --- база данных
DATABASE_URL=postgresql+asyncpg://opspacebank:opspacebank@localhost:5432/opspacebank

# --- JWT (обязательно поменяйте секрет: openssl rand -hex 32)
JWT_SECRET=change-me-please-32-bytes-minimum-secret
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# --- 2FA: true — без включённой 2FA в систему не пустит (при входе попросит настроить)
REQUIRE_2FA=false

# --- адреса
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
MOBILE_REDIRECT=ru.opspacebank.app://oauth
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost

# --- Яндекс ID: https://oauth.yandex.ru/client/new
# Redirect URI в настройках приложения Яндекса: {BACKEND_PUBLIC_URL}/api/v1/auth/yandex/callback
# Права: «Доступ к адресу электронной почты», «Доступ к портрету пользователя»
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- AI-помощник: none | openai | anthropic
# none — отвечает встроенная база знаний (работает без ключей)
LLM_PROVIDER=none
LLM_API_KEY=
# YandexGPT (OpenAI-совместимый API):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
#   LLM_FOLDER_ID=<folder_id>
#   LLM_API_KEY=<API-ключ сервисного аккаунта>
# Claude:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FOLDER_ID=
