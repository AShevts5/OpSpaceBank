{
  "name": "opspacebank-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OpSpaceBank — помощник банка: дискретная математика в бизнес-процессах (PWA + Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "build:mobile": "vite build --mode mobile && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "7.0.1",
    "@capacitor/browser": "7.0.1",
    "@capacitor/core": "7.4.3",
    "@capacitor/status-bar": "7.0.1",
    "@fontsource/golos-text": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.2",
    "@fontsource/onest": "5.1.1",
    "framer-motion": "11.18.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/cli": "7.4.3",
    "@capacitor/ios": "7.4.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1"
  },
  "engines": {
    "node": ">=18"
  }
}
